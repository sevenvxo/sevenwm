# values

def get(data, path, default=None):
    node = data
    for part in path.split("."):
        if not isinstance(node, dict) or part not in node:
            return default
        node = node[part]
    return node


def put(data, path, value):
    *parents, leaf = path.split(".")
    node = data
    for part in parents:
        node = node.setdefault(part, {})
    node[leaf] = value


def merge(base, over):
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            merge(base[key], value)
        else:
            base[key] = copy.deepcopy(value)
    return base


def toml_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(v) for v in value) + "]"
    raise TypeError(f"can't write {value!r}")


def split_value_comment(rest):
    """split value and comment at the first # thats not in a string"""
    quote = None
    for i, ch in enumerate(rest):
        if quote:
            if ch == "\\":
                continue
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "#":
            return rest[:i].rstrip(), rest[i:]
    return rest.rstrip(), ""


KEY_LINE = re.compile(r'^(\s*)("[^"]*"|[A-Za-z0-9_\-]+)(\s*=\s*)(.*)$')


def write_config(data, template):
    """the config text from the template w ur values filled in and its comments kept"""
    out, section = [], ""
    bindings = dict(data.get("keybindings", {}))

    def flush_bindings():
        # binds that arent in the template go at the end of their section
        if section == "keybindings" and bindings:
            while out and not out[-1].strip():
                out.pop()
            out.append("")
            for combo, action in bindings.items():
                out.append(f"{toml_value(combo)} = {toml_value(action)}")
            bindings.clear()
            out.append("")

    for line in template.splitlines():
        header = re.match(r"^\s*\[\[?([^\]]+)\]\]?\s*$", line)
        if header:
            flush_bindings()
            section = header.group(1).strip()
            out.append(line)
            continue
        match = KEY_LINE.match(line)
        if not match or line.lstrip().startswith("#"):
            out.append(line)
            continue
        indent, key, eq, rest = match.groups()
        if section == "keybindings":
            combo = json.loads(key) if key.startswith('"') else key
            # a removed default has to say so or sevenwm fills it back in
            value = bindings.pop(combo) if combo in bindings else "none"
        else:
            value = get(data, f"{section}.{key}" if section else key)
            if value is None:
                out.append(line)
                continue
        old_value, comment = split_value_comment(rest)
        new_value = toml_value(value)
        if comment:
            # keep the comment in the same column
            column = len(rest) - len(comment)
            out.append(f"{indent}{key}{eq}{new_value.ljust(column - 1)} {comment}")
        else:
            out.append(f"{indent}{key}{eq}{new_value}")
    flush_bindings()
    for rule in data.get("rules", []):
        out.append("")
        out.append("[[rules]]")
        for key in ("app_id", "title", "float", "size", "hide_from_screencast"):
            if rule.get(key) is not None:
                out.append(f"{key} = {toml_value(rule[key])}")
    for monitor in data.get("monitors", []):
        out.append("")
        out.append("[[monitors]]")
        for key in ("name", "position", "mode", "scale"):
            if monitor.get(key) is not None:
                out.append(f"{key} = {toml_value(monitor[key])}")
    return "\n".join(out) + "\n"


# colors

def to_rgba(text):
    rgba = Gdk.RGBA()
    hexpart = text.lstrip("#")
    if len(hexpart) == 8:
        rgba.parse("#" + hexpart[:6])
        rgba.alpha = int(hexpart[6:], 16) / 255
    else:
        rgba.parse("#" + hexpart[:6])
    return rgba


def from_rgba(rgba):
    r, g, b = (round(c * 255) for c in (rgba.red, rgba.green, rgba.blue))
    a = round(rgba.alpha * 255)
    text = f"#{r:02x}{g:02x}{b:02x}"
    return text if a == 255 else text + f"{a:02x}"


def hexcolor(rgb, alpha=None):
    text = "#" + "".join(f"{max(0, min(255, round(c * 255))):02x}" for c in rgb)
    return text if alpha is None else text + f"{round(alpha * 255):02x}"


def theme_from_wallpaper(path):
    """picks a theme from the wallpaper w its most vivid color as the accent"""
    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 64, 64, True)
    pixels = pixbuf.get_pixels()
    n, stride = pixbuf.get_n_channels(), pixbuf.get_rowstride()
    samples = []
    for y in range(pixbuf.get_height()):
        for x in range(pixbuf.get_width()):
            i = y * stride + x * n
            samples.append(tuple(c / 255 for c in pixels[i:i + 3]))
    hsv = [colorsys.rgb_to_hsv(*c) for c in samples]

    # the accent is the hue w the most vivid pixels
    bins = [[0.0, 0.0, 0.0, 0.0] for _ in range(18)]  # weight h s v
    for h, s, v in hsv:
        weight = (s * v) ** 2
        if s < 0.25 or v < 0.2:
            continue
        b = bins[int(h * 18) % 18]
        b[0] += weight
        b[1] += h * weight
        b[2] += s * weight
        b[3] += v * weight
    best = max(bins, key=lambda b: b[0])
    if best[0] > 0:
        h, s, v = best[1] / best[0], best[2] / best[0], best[3] / best[0]
        accent = colorsys.hsv_to_rgb(h, min(1.0, max(s, 0.55)), max(v, 0.8))
    else:
        # grey wallpaper so use a plain light accent
        h, s, accent = 0.0, 0.0, (0.9, 0.9, 0.92)

    # the background does a dark tones thing w the wallpaper
    dark = sorted(samples, key=lambda c: sum(c))[: max(1, len(samples) // 3)]
    avg = [sum(c[i] for c in dark) / len(dark) for i in range(3)]
    dh, ds, dv = colorsys.rgb_to_hsv(*avg)
    background = colorsys.hsv_to_rgb(dh, min(ds, 0.35), min(max(dv, 0.05), 0.12))
    menu_bg = colorsys.hsv_to_rgb(dh, min(ds, 0.3), min(max(dv, 0.05), 0.12) + 0.05)
    hover = tuple(m * 0.7 + a * 0.3 for m, a in zip(menu_bg, accent))
    edge = tuple(m * 0.5 + a * 0.5 for m, a in zip(menu_bg, accent))
    return {
        "canvas.background": hexcolor(background),
        "canvas.region_outline": hexcolor(accent, 0.25),
        "canvas.drop_highlight": hexcolor(accent, 0.15),
        "border.focused": hexcolor(accent),
        "border.unfocused": hexcolor(accent, 0.3),
        "theme.menu_background": hexcolor(menu_bg),
        "theme.menu_text": "#ececec",
        "theme.menu_hover": hexcolor(hover),
        "theme.menu_disabled": "#80808a",
        "theme.menu_edge": hexcolor(edge),
    }


# animation preview

def _spring(t):
    import math
    return 1.0 if t >= 1 else 1 - math.exp(-6 * t) * math.cos(10.5 * t)


def _back(t):
    c1, c3 = 1.70158, 2.70158
    return 1 + c3 * (t - 1) ** 3 + c1 * (t - 1) ** 2


# keep this in sync w sevenwms src/animation.rs
CURVES = {
    "linear": lambda t: t,
    "ease-out-quad": lambda t: 1 - (1 - t) ** 2,
    "ease-out-cubic": lambda t: 1 - (1 - t) ** 3,
    "ease-out-expo": lambda t: 1.0 if t >= 1 else 1 - 2 ** (-10 * t),
    "ease-in-out-cubic": lambda t: 4 * t ** 3 if t < 0.5 else 1 - (-2 * t + 2) ** 3 / 2,
    "back": _back,
    "spring": _spring,
}


def ease(curve, t):
    return CURVES.get(curve, CURVES["ease-out-cubic"])(min(max(t, 0.0), 1.0))


def look(style, p):
    """dx dy scale and alpha of a window p of the way in"""
    fade = min(max(p, 0.0), 1.0)
    if style == "fade":
        return 0, 0, 1, fade
    if style == "zoom":
        return 0, 0, max(0.85 + 0.15 * p, 0.01), fade
    if style == "pop":
        return 0, 0, max(0.5 + 0.5 * p, 0.01), min(max(p * 3, 0.0), 1.0)
    if style == "slide":
        return 0, 40 * (1 - p), 1, fade
    return 0, 0, 1, 1


class AnimationPreview(Gtk.DrawingArea):
    """a fake window that opens slides and closes to preview the animations"""

    W, H = 520, 260

    def __init__(self, settings):
        super().__init__()
        self.settings = settings
        self.set_size_request(self.W, self.H)
        self.connect("draw", self.draw)
        self.steps = []
        self.started = 0
        self.tick_id = None
        GLib.idle_add(lambda: self.play() and False)

    def ms(self, path):
        return max(int(get(self.settings.data, path) or 0), 0)

    def play(self, part=None):
        a = "animations."
        parts = {
            "open": ("open", self.ms(a + "open_ms")),
            "move": ("move", self.ms(a + "move_ms")),
            "close": ("close", self.ms(a + "close_ms")),
            "fly": ("fly", self.ms("view.fly_duration_ms")),
        }
        order = ["open", "move", "fly", "close"] if part is None else [part]
        self.steps = []
        for name in order:
            kind, length = parts[name]
            self.steps.append((kind, max(length, 1)))
            self.steps.append(("pause", 450))
        self.started = GLib.get_monotonic_time()
        if self.tick_id is None:
            self.tick_id = self.add_tick_callback(self.tick)
        return True

    def tick(self, _widget, _clock):
        self.queue_draw()
        total = sum(length for _, length in self.steps)
        if (GLib.get_monotonic_time() - self.started) / 1000 > total + 50:
            self.tick_id = None
            return False
        return True

    def state(self):
        """what the fake window looks like right now"""
        data = self.settings.data
        a = "animations."
        enabled = get(data, a + "enabled")
        elapsed = (GLib.get_monotonic_time() - self.started) / 1000
        x, view_x, the_look, shown = 0.0, 0.0, (0, 0, 1, 1), True
        slid, flown = False, False
        for kind, length in self.steps:
            t = elapsed / length if elapsed < length else 1.0
            if kind == "open":
                p = ease(get(data, a + "open_curve"), t) if enabled else 1
                the_look = look(get(data, a + "open_style"), p) if t < 1 else (0, 0, 1, 1)
            elif kind == "move":
                p = ease(get(data, a + "move_curve"), t) if enabled else 1
                x = 120 * p
                slid = True
            elif kind == "fly":
                p = ease(get(data, a + "fly_curve"), t) if enabled else 1
                view_x = 120 * p
                flown = True
            elif kind == "close":
                p = 1 - ease(get(data, a + "close_curve"), t) if enabled else 0
                the_look = look(get(data, a + "close_style"), p)
                shown = t < 1 and enabled
            if elapsed < length:
                break
            elapsed -= length
        else:
            # all done so the window is back at rest
            return 0.0, (0, 0, 1, 1), 0.0, True
        if slid and not flown:
            view_x = 0.0
        return x, the_look, view_x, shown

    def draw(self, _widget, cr):
        import math
        data = self.settings.data
        w, h = self.get_allocated_width(), self.get_allocated_height()
        rgba = to_rgba(get(data, "canvas.background") or "#141418")
        cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 1)
        cr.rectangle(0, 0, w, h)
        cr.fill()
        x, (dx, dy, scale, alpha), view_x, shown = self.state()
        # a faint grid for the canvas so u can see the view move
        cr.set_source_rgba(1, 1, 1, 0.06)
        for gx in range(-40, w + 80, 40):
            px = gx - (view_x % 40)
            cr.rectangle(px, 0, 1, h)
        cr.fill()
        if not shown:
            return
        ww, wh = 220, 140
        cx = w / 2 - 60 + x - view_x + dx
        cy = h / 2 + dy
        ww, wh = ww * scale, wh * scale
        left, top = cx - ww / 2, cy - wh / 2
        radius = min(get(data, "decorations.corner_radius") or 0, ww / 2, wh / 2) * scale

        def rounded(x0, y0, rw, rh, r):
            r = max(min(r, rw / 2, rh / 2), 0)
            cr.new_path()
            cr.arc(x0 + rw - r, y0 + r, r, -math.pi / 2, 0)
            cr.arc(x0 + rw - r, y0 + rh - r, r, 0, math.pi / 2)
            cr.arc(x0 + r, y0 + rh - r, r, math.pi / 2, math.pi)
            cr.arc(x0 + r, y0 + r, r, math.pi, 3 * math.pi / 2)
            cr.close_path()

        if get(data, "decorations.shadow"):
            size = (get(data, "decorations.shadow_size") or 0) * scale
            ox, oy = [v * scale for v in (get(data, "decorations.shadow_offset") or [0, 0])]
            color = to_rgba(get(data, "decorations.shadow_color") or "#00000080")
            steps = 8
            for i in range(steps, 0, -1):
                grow = size * i / steps
                cr.set_source_rgba(color.red, color.green, color.blue,
                                   color.alpha * alpha / steps * 1.4)
                rounded(left + ox - grow / 2, top + oy - grow / 2, ww + grow, wh + grow,
                        radius + grow / 2)
                cr.fill()
        border = (get(data, "border.width") or 0) * scale
        if border:
            color = to_rgba(get(data, "border.focused") or "#ffffff")
            cr.set_source_rgba(color.red, color.green, color.blue, color.alpha * alpha)
            rounded(left - border, top - border, ww + 2 * border, wh + 2 * border,
                    radius + border if radius else 0)
            cr.fill()
        cr.set_source_rgba(0.12, 0.12, 0.15, alpha)
        rounded(left, top, ww, wh, radius)
        cr.fill()
        # some fake text lines so moving and scaling are easy to see
        cr.set_source_rgba(0.85, 0.85, 0.9, 0.7 * alpha)
        for i in range(5):
            cr.rectangle(left + 14 * scale, top + (20 + i * 20) * scale,
                         (ww - 28 * scale) * (0.9 - 0.12 * i), 6 * scale)
        cr.fill()


# the window

class Settings(ShellPages, SystemPages, Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Settings")
        self.set_default_size(920, 680)
        self.template = open(defaults_path()).read()
        self.defaults = tomllib.loads(self.template)
        self.load()
        self.color_buttons = {}

        header = Gtk.HeaderBar(show_close_button=True, title="Settings")
        self.set_titlebar(header)
        save = Gtk.Button(label="Save")
        save.get_style_context().add_class("suggested-action")
        save.connect("clicked", lambda _: self.save())
        revert = Gtk.Button(label="Revert")
        revert.connect("clicked", lambda _: self.revert())
        header.pack_end(save)
        header.pack_start(revert)
        # save and revert are for config pages bc system pages act right away
        self.config_buttons = (save, revert)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        sidebar = Gtk.StackSidebar(stack=self.stack)
        box = Gtk.Box()
        box.pack_start(sidebar, False, False, 0)
        box.pack_start(self.stack, True, True, 0)
        self.status = Gtk.Label(xalign=0, margin=8)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.pack_start(box, True, True, 0)
        outer.pack_start(self.status, False, False, 0)
        self.add(outer)
        self.build_pages()
        self.stack.connect("notify::visible-child-name", lambda *_: self.page_shown())

    def page_shown(self):
        name = self.stack.get_visible_child_name()
        for button in self.config_buttons:
            button.set_visible(not self.is_system_page(name))
        self.refresh_system_page(name)
        if name == "notifications":
            self.refresh_history()

    def show_page(self, name):
        if self.stack.get_child_by_name(name):
            self.stack.set_visible_child_name(name)
        else:
            self.say(f"There's no page called '{name}'.", error=True)

    def load(self):
        user = {}
        if os.path.exists(CONFIG):
            with open(CONFIG, "rb") as f:
                user = tomllib.load(f)
        self.data = merge(copy.deepcopy(self.defaults), user)
        self.data.setdefault("rules", [])
        self.data.setdefault("monitors", [])
        self.load_shell(merge)

    def revert(self):
        self.load()
        for child in self.stack.get_children():
            self.stack.remove(child)
        self.color_buttons = {}
        self.build_pages()
        self.show_all()
        self.page_shown()
        self.say("Reverted to the saved config.")

    def say(self, text, error=False):
        if not hasattr(self, "status"):
            print(text, file=sys.stderr)
            return
        markup = GLib.markup_escape_text(text)
        self.status.set_markup(f'<span foreground="#e06c75">{markup}</span>' if error else markup)

    def save(self):
        text = write_config(self.data, self.template)
        binary = sevenwm_binary()
        if binary:
            with tempfile.NamedTemporaryFile("w", suffix=".toml", delete=False) as tmp:
                tmp.write(text)
            check = subprocess.run([binary, "--check-config", tmp.name],
                                   capture_output=True, text=True)
            os.unlink(tmp.name)
            if check.returncode != 0:
                self.say("Not saved — " + check.stdout.strip().removeprefix("error: "), error=True)
                return
        shell_text, shell_error = self.shell_text(write_config)
        if shell_error:
            self.say("Not saved — " + shell_error, error=True)
            return
        if shell_text is not None:
            self.save_shell(shell_text)
        os.makedirs(CONFIG_DIR, exist_ok=True)
        old = open(CONFIG).read() if os.path.exists(CONFIG) else None
        # nothing changed here so leave it and sevenwm wont reload for nothing
        if old != text:
            if old is not None:
                shutil.copy(CONFIG, CONFIG + ".bak")
            # write it next to the file then swap it in so sevenwm never reads half of it
            with open(CONFIG + ".tmp", "w") as f:
                f.write(text)
            os.replace(CONFIG + ".tmp", CONFIG)
        self.say("Saved — applied within a second. (Previous files: config.toml.bak)")

    # building blocks

    def page(self, name, title):
        grid = Gtk.Grid(column_spacing=16, row_spacing=10, margin=20)
        scroller = Gtk.ScrolledWindow()
        scroller.add(grid)
        self.stack.add_titled(scroller, name, title)
        grid.row = 0
        return grid

    def heading(self, grid, text):
        label = Gtk.Label(xalign=0, margin_top=12 if grid.row else 0)
        label.set_markup(f"<b>{GLib.markup_escape_text(text)}</b>")
        grid.attach(label, 0, grid.row, 2, 1)
        grid.row += 1

    def row(self, grid, label, widget, hint=None):
        lab = Gtk.Label(label=label, xalign=0)
        if hint:
            lab.set_tooltip_text(hint)
            widget.set_tooltip_text(hint)
        grid.attach(lab, 0, grid.row, 1, 1)
        widget.set_hexpand(False)
        widget.set_halign(Gtk.Align.START)
        grid.attach(widget, 1, grid.row, 1, 1)
        grid.row += 1

    def switch(self, grid, path, label, hint=None):
        w = Gtk.Switch(active=bool(get(self.data, path)))
        w.connect("notify::active", lambda s, _: put(self.data, path, s.get_active()))
        self.row(grid, label, w, hint)

    def number(self, grid, path, label, low, high, step=1, digits=0, hint=None):
        adj = Gtk.Adjustment(value=get(self.data, path), lower=low, upper=high,
                             step_increment=step, page_increment=step * 10)
        w = Gtk.SpinButton(adjustment=adj, digits=digits, numeric=True)
        is_int = digits == 0

        def changed(spin):
            value = spin.get_value()
            put(self.data, path, int(round(value)) if is_int else round(value, digits))
        w.connect("value-changed", changed)
        self.row(grid, label, w, hint)

    def choice(self, grid, path, label, options, hint=None, on_change=None):
        w = Gtk.ComboBoxText()
        for value in options:
            w.append(value, value)
        w.set_active_id(str(get(self.data, path)))

        def changed(combo):
            put(self.data, path, combo.get_active_id())
            if on_change:
                on_change(combo.get_active_id())
        w.connect("changed", changed)
        self.row(grid, label, w, hint)
        return w

    def text(self, grid, path, label, width=40, hint=None):
        w = Gtk.Entry(text=get(self.data, path) or "", width_chars=width)
        w.connect("changed", lambda e: put(self.data, path, e.get_text()))
        self.row(grid, label, w, hint)
        return w

    def color(self, grid, path, label):
        w = Gtk.ColorButton(use_alpha=True)
        w.set_rgba(to_rgba(get(self.data, path)))
        w.connect("color-set", lambda b: put(self.data, path, from_rgba(b.get_rgba())))
        self.color_buttons[path] = w
        self.row(grid, label, w)

    def pair(self, grid, path, label, low, high, hint=None):
        box = Gtk.Box(spacing=6)
        values = list(get(self.data, path))
        for i in range(2):
            adj = Gtk.Adjustment(value=values[i], lower=low, upper=high, step_increment=10)
            spin = Gtk.SpinButton(adjustment=adj, numeric=True)

            def changed(s, i=i):
                current = list(get(self.data, path))
                current[i] = int(s.get_value())
                put(self.data, path, current)
            spin.connect("value-changed", changed)
            box.pack_start(spin, False, False, 0)
            if i == 0:
                box.pack_start(Gtk.Label(label="×"), False, False, 0)
        self.row(grid, label, box, hint)

