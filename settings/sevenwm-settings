    def page_monitors(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=16)
        try:
            with open(os.path.join(RUNTIME, "monitors.json")) as f:
                live = json.load(f)
        except (OSError, ValueError):
            live = []
        if not live:
            box.pack_start(Gtk.Label(
                label="No monitors reported — is sevenwm running?", xalign=0), False, False, 0)
            self.stack.add_titled(box, "monitors", "Monitors")
            return

        configured = {m["name"]: m for m in get(self.data, "monitors", [])}
        monitors = []
        for m in live:
            conf = configured.get(m["name"], {})
            monitors.append({
                "name": m["name"],
                "position": list(conf.get("position", m["position"])),
                "size": m["size"],
                "mode": conf.get("mode", m.get("mode") or "auto"),
                "modes": m.get("modes") or [],
                "scale": conf.get("scale", m.get("scale", 1.0)),
            })

        def store():
            put(self.data, "monitors", [
                {"name": m["name"], "position": m["position"], "mode": m["mode"],
                 "scale": m["scale"]} for m in monitors])

        area = Gtk.DrawingArea()
        area.set_size_request(-1, 320)
        area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK)
        drag = {"index": None, "offset": (0, 0)}
        selected = {"index": 0}

        def layout_scale(width, height):
            xs = [m["position"][0] for m in monitors] + [m["position"][0] + m["size"][0] for m in monitors]
            ys = [m["position"][1] for m in monitors] + [m["position"][1] + m["size"][1] for m in monitors]
            span_w, span_h = max(xs) - min(xs), max(ys) - min(ys)
            scale = min((width - 60) / max(span_w * 1.6, 1), (height - 40) / max(span_h * 1.6, 1))
            return scale, min(xs) - span_w * 0.3, min(ys) - span_h * 0.3

        def draw(widget, cr):
            w, h = widget.get_allocated_width(), widget.get_allocated_height()
            scale, ox, oy = layout_scale(w, h)
            for i, m in enumerate(monitors):
                x, y = (m["position"][0] - ox) * scale, (m["position"][1] - oy) * scale
                mw, mh = m["size"][0] * scale, m["size"][1] * scale
                cr.set_source_rgb(0.25, 0.45, 0.8) if i == selected["index"] else cr.set_source_rgb(0.35, 0.35, 0.4)
                cr.rectangle(x, y, mw, mh)
                cr.fill()
                cr.set_source_rgb(1, 1, 1)
                cr.move_to(x + 8, y + 20)
                cr.show_text(m["name"])
                cr.move_to(x + 8, y + 36)
                cr.show_text(f"{m['size'][0]}×{m['size'][1]} @ {m['position'][0]},{m['position'][1]}")
            return False
        area.connect("draw", draw)

        def hit(event):
            scale, ox, oy = layout_scale(area.get_allocated_width(), area.get_allocated_height())
            lx, ly = event.x / scale + ox, event.y / scale + oy
            for i, m in reversed(list(enumerate(monitors))):
                x, y = m["position"]
                if x <= lx < x + m["size"][0] and y <= ly < y + m["size"][1]:
                    return i, (lx - x, ly - y)
            return None, None

        def press(_w, event):
            i, offset = hit(event)
            if i is not None:
                drag["index"], drag["offset"] = i, offset
                selected["index"] = i
                show_selected()
                area.queue_draw()

        def motion(_w, event):
            i = drag["index"]
            if i is None:
                return
            scale, ox, oy = layout_scale(area.get_allocated_width(), area.get_allocated_height())
            x = event.x / scale + ox - drag["offset"][0]
            y = event.y / scale + oy - drag["offset"][1]
            # snap edges to the other monitors edges
            m = monitors[i]
            snap = 60
            for other in monitors:
                if other is m:
                    continue
                ox2, oy2 = other["position"]
                ow, oh = other["size"]
                for candidate in (ox2 + ow, ox2 - m["size"][0], ox2, ox2 + ow - m["size"][0]):
                    if abs(x - candidate) < snap:
                        x = candidate
                for candidate in (oy2, oy2 + oh, oy2 - m["size"][1], oy2 + oh - m["size"][1]):
                    if abs(y - candidate) < snap:
                        y = candidate
            m["position"] = [int(round(x)), int(round(y))]
            area.queue_draw()

        def release(_w, _e):
            if drag["index"] is not None:
                drag["index"] = None
                store()
                show_selected()

        area.connect("button-press-event", press)
        area.connect("motion-notify-event", motion)
        area.connect("button-release-event", release)
        frame = Gtk.Frame()
        frame.add(area)
        box.pack_start(Gtk.Label(label="Drag monitors to arrange them; edges snap together.",
                                 xalign=0), False, False, 0)
        box.pack_start(frame, False, False, 0)

        details = Gtk.Grid(column_spacing=16, row_spacing=10)
        name_label = Gtk.Label(xalign=0)
        mode_combo = Gtk.ComboBoxText()
        scale_spin = Gtk.SpinButton(adjustment=Gtk.Adjustment(
            value=1, lower=0.5, upper=4, step_increment=0.25), digits=2, numeric=True)
        position_label = Gtk.Label(xalign=0)
        for r, (title, widget) in enumerate((("Monitor", name_label), ("Mode", mode_combo),
                                              ("Scale", scale_spin), ("Position", position_label))):
            details.attach(Gtk.Label(label=title, xalign=0), 0, r, 1, 1)
            details.attach(widget, 1, r, 1, 1)
        updating = {"now": False}

        def show_selected():
            updating["now"] = True
            m = monitors[selected["index"]]
            name_label.set_text(m["name"])
            mode_combo.remove_all()
            mode_combo.append("auto", "auto (best refresh)")
            for mode in dict.fromkeys(m["modes"] or [m["mode"]]):
                if mode != "auto":
                    mode_combo.append(mode, mode.replace("@", " @ ") + " Hz")
            if not mode_combo.set_active_id(m["mode"]):
                mode_combo.set_active_id("auto")
            scale_spin.set_value(m["scale"])
            position_label.set_text(f"{m['position'][0]}, {m['position'][1]}")
            updating["now"] = False

        def mode_changed(combo):
            if not updating["now"] and combo.get_active_id():
                monitors[selected["index"]]["mode"] = combo.get_active_id()
                store()

        def scale_changed(spin):
            if not updating["now"]:
                monitors[selected["index"]]["scale"] = round(spin.get_value(), 2)
                store()
        mode_combo.connect("changed", mode_changed)
        scale_spin.connect("value-changed", scale_changed)
        reset = Gtk.Button(label="Reset to automatic (left to right)")

        def on_reset(_):
            put(self.data, "monitors", [])
            self.say("Monitors: automatic — save to apply.")
        reset.connect("clicked", on_reset)
        box.pack_start(details, False, False, 0)
        box.pack_start(reset, False, False, 0)
        show_selected()
        self.stack.add_titled(box, "monitors", "Monitors")

    def page_rules(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=16)
        box.pack_start(Gtk.Label(
            label="Rules for windows whose app id / title match (* and ? wildcards). "
                  "Later rules win.", xalign=0, wrap=True), False, False, 0)
        # app_id title placement width height hide
        store = Gtk.ListStore(str, str, str, str, str, bool)
        for rule in get(self.data, "rules", []):
            placement = {True: "float", False: "tile"}.get(rule.get("float"), "default")
            size = rule.get("size") or ["", ""]
            store.append([rule.get("app_id") or "", rule.get("title") or "", placement,
                          str(size[0]), str(size[1]), bool(rule.get("hide_from_screencast"))])

        def sync():
            rules = []
            for app_id, title, placement, w, h, hide in store:
                rule = {}
                if app_id:
                    rule["app_id"] = app_id
                if title:
                    rule["title"] = title
                if placement != "default":
                    rule["float"] = placement == "float"
                if w.isdigit() and h.isdigit():
                    rule["size"] = [int(w), int(h)]
                if hide:
                    rule["hide_from_screencast"] = True
                if rule.get("app_id") or rule.get("title"):
                    rules.append(rule)
            put(self.data, "rules", rules)

        view = Gtk.TreeView(model=store)
        for col, title in ((0, "App id"), (1, "Title"), (3, "Width"), (4, "Height")):
            cell = Gtk.CellRendererText(editable=True)

            def edited(_c, path, text, col=col):
                store[path][col] = text
                sync()
            cell.connect("edited", edited)
            view.append_column(Gtk.TreeViewColumn(title, cell, text=col))
        placements = Gtk.ListStore(str)
        for p in ("default", "float", "tile"):
            placements.append([p])
        combo = Gtk.CellRendererCombo(editable=True, model=placements, text_column=0, has_entry=False)

        def placement_edited(_c, path, text):
            store[path][2] = text
            sync()
        combo.connect("edited", placement_edited)
        view.insert_column(Gtk.TreeViewColumn("Placement", combo, text=2), 2)
        toggle = Gtk.CellRendererToggle()

        def toggled(_c, path):
            store[path][5] = not store[path][5]
            sync()
        toggle.connect("toggled", toggled)
        view.append_column(Gtk.TreeViewColumn("Hide from screencast", toggle, active=5))
        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.add(view)
        buttons = Gtk.Box(spacing=6)
        add, remove = Gtk.Button(label="Add"), Gtk.Button(label="Remove")

        def on_add(_):
            it = store.append(["", "", "float", "", "", False])
            view.set_cursor(store.get_path(it), view.get_column(0), True)
        add.connect("clicked", on_add)

        def on_remove(_):
            model, it = view.get_selection().get_selected()
            if it:
                model.remove(it)
                sync()
        remove.connect("clicked", on_remove)
        buttons.pack_start(add, False, False, 0)
        buttons.pack_start(remove, False, False, 0)
        box.pack_start(scroller, True, True, 0)
        box.pack_start(buttons, False, False, 0)
        self.stack.add_titled(box, "rules", "Window rules")


def main():
    # only one settings window so running it again brings the open one forward
    app = Gtk.Application(application_id="org.sevenwm.Settings",
                          flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)

    def command_line(app, cmd):
        args = cmd.get_arguments()[1:]
        window = app.get_active_window()
        if window is None:
            window = Settings(app)
            window.show_all()
        if "--page" in args and args.index("--page") + 1 < len(args):
            window.show_page(args[args.index("--page") + 1])
        window.page_shown()
        window.present()
        return 0
    app.connect("command-line", command_line)
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()
