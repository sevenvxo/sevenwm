def defaults_path():
    """sevenwm defaults from whichever is newer the running copy or maybe the repo"""
    paths = [p for p in (os.path.join(RUNTIME, "defaults.toml"),
                         os.path.join(HERE, "..", "config.default.toml"))
             if os.path.exists(p)]
    if not paths:
        sys.exit("sevenwm-settings: can't find sevenwm's default config")
    return max(paths, key=os.path.getmtime)


def cursor_themes():
    """cursor themes that are installed"""
    dirs = [os.path.expanduser("~/.icons"),
            os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "icons")]
    dirs += [os.path.join(d, "icons")
             for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
    themes = {"default"}
    for d in dirs:
        if os.path.isdir(d):
            for name in os.listdir(d):
                if os.path.isdir(os.path.join(d, name, "cursors")):
                    themes.add(name)
    return ["default"] + sorted(themes - {"default"}, key=str.lower)


def sevenwm_binary():
    for candidate in (shutil.which("sevenwm"),
                      os.path.join(HERE, "..", "target", "release", "sevenwm"),
                      os.path.join(HERE, "..", "target", "debug", "sevenwm")):
        if candidate and os.path.exists(candidate):
            return candidate
    return None


